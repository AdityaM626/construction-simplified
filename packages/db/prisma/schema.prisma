datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?
  fullName     String
  phone        String
  role         String
  isVerified   Boolean  @default(false)
  createdAt    DateTime @default(now())

  builderProfile BuilderProfile?
  dealerProfile  DealerProfile?
  projects       Project[]       @relation("HomeownerProjects")
  assigned       Project[]       @relation("BuilderProjects")
  auditEvents    AuditEvent[]
}

model ConstructionTeamMember {
  id                     String   @id @default(uuid())
  projectId              String
  contractorId           String
  name                   String
  role                   String   // ELECTRICIAN, PLUMBER, PAINTER, ARCHITECT, MASON, GENERAL_LABOUR
  phone                  String
  specialization         String
  assignedMilestoneId    String?
  assignedMilestoneTitle String?
  status                 String   @default("ACTIVE") // ACTIVE, UPCOMING, COMPLETED
  createdAt              DateTime @default(now())

  project                Project  @relation(fields: [projectId], references: [id])
}

model BuilderProfile {
  id                     String   @id @default(uuid())
  userId                 String   @unique
  companyName            String
  experienceYears        Int
  serviceArea            String
  verificationStatus     String   @default("VERIFIED")
  portfolioJson          String?
  rating                 Float    @default(4.9)
  completedProjectsCount Int      @default(28)
  specialtiesJson        String?
  user                   User     @relation(fields: [userId], references: [id])
}

model DealerProfile {
  id                 String         @id @default(uuid())
  userId             String         @unique
  businessName       String
  gstNumber          String
  serviceRadiusKm    Int            @default(35)
  verificationStatus String         @default("VERIFIED")
  address            String
  rating             Float          @default(4.9)
  user               User           @relation(fields: [userId], references: [id])
  products           Product[]
  orders             OrderRequest[]
}

model Project {
  id                   String   @id @default(uuid())
  homeownerId          String
  homeownerName        String?
  builderId            String?
  builderName          String?
  name                 String
  type                 String   @default("NEW_CONSTRUCTION")
  location             String
  builtUpAreaSqFt     Float?
  plotAreaSqFt         Float?
  contractValue        Float?
  totalBudget          Float
  spentCost            Float    @default(0.0)
  committedCost        Float    @default(0.0)
  paidAmount           Float?   @default(0.0)
  targetCompletionDate String
  status               String   @default("IN_PROGRESS")
  createdAt            DateTime @default(now())

  homeowner            User     @relation("HomeownerProjects", fields: [homeownerId], references: [id])
  builder              User?    @relation("BuilderProjects", fields: [builderId], references: [id])

  milestones           Milestone[]
  siteUpdates          SiteUpdate[]
  materialRequirements MaterialRequirement[]
  orderRequests        OrderRequest[]
  deliveryJobs         DeliveryJob[]
  documents            DocumentRecord[]
  ledgerEvents         ProjectLedgerEvent[]
  teamMembers          ConstructionTeamMember[]
  boqs                 BOQ[]
  changeOrders         ChangeOrder[]
  issues               IssueRecord[]
  dailySiteReports     DailySiteReport[]
  qualityCheckpoints   QualityCheckpoint[]
  defectRecords        DefectRecord[]
}

model BOQ {
  id                  String    @id @default(uuid())
  projectId           String
  title               String
  totalEstimatedValue Float
  totalActualValue    Float?    @default(0.0)
  variance            Float?    @default(0.0)
  createdAt           DateTime  @default(now())

  project             Project   @relation(fields: [projectId], references: [id])
  items               BOQItem[]
}

model BOQItem {
  id             String @id @default(uuid())
  boqId          String
  category       String
  itemName       String
  description    String?
  quantity       Float  @default(1.0)
  unit           String
  estimatedRate  Float
  estimatedTotal Float
  actualSpent    Float  @default(0.0)
  variance       Float  @default(0.0)

  boq            BOQ    @relation(fields: [boqId], references: [id])
}

model ChangeOrder {
  id                 String   @id @default(uuid())
  projectId          String
  title              String
  description        String?
  costImpact         Float
  timelineImpactDays Int
  requestedBy        String
  requestedByRole    String
  approvedBy         String?
  approvedAt         String?
  status             String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt          DateTime @default(now())

  project            Project  @relation(fields: [projectId], references: [id])
}

model IssueRecord {
  id              String   @id @default(uuid())
  projectId       String
  title           String
  description     String
  category        String?
  createdBy       String
  createdByRole   String
  assignedTo      String?
  photoUrl        String?
  resolutionNotes String?
  resolvedAt      String?
  severity        String   @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  status          String   @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  createdAt       DateTime @default(now())

  project         Project  @relation(fields: [projectId], references: [id])
}

model DailySiteReport {
  id                  String   @id @default(uuid())
  projectId           String
  date                String
  weather             String?
  workersPresentCount Int      @default(10)
  workCompleted       String
  materialsReceived   String?
  issuesEncountered   String?
  photoUrls           String   // JSON stringified array of photo URLs
  tomorrowsPlan       String
  submittedBy         String
  createdAt           DateTime @default(now())

  project             Project  @relation(fields: [projectId], references: [id])
}

model QualityCheckpoint {
  id             String   @id @default(uuid())
  projectId      String
  title          String
  category       String   // WATERPROOFING, CONCRETE_CURING, REBAR_SPACING, SHUTTERING, PLUMBING_LEAK_TEST, ELECTRICAL_EARTHING
  status         String   @default("PASS") // PASS, FAIL, REWORK_REQUIRED
  inspectorName  String
  inspectionDate String
  notes          String
  photoUrls      String   // JSON stringified array
  createdAt      DateTime @default(now())

  project        Project  @relation(fields: [projectId], references: [id])
}

model DefectRecord {
  id               String    @id @default(uuid())
  projectId        String
  title            String
  description      String
  defectType       String    // CRACK, SEEPAGE, PAINT_DEFECT, ELECTRICAL_FAULT, PLUMBING_LEAK, OTHER
  location         String
  severity         String    @default("MEDIUM")
  responsibleTrade String
  reworkTimeDays   Int
  reworkCost       Float
  status           String    @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, VERIFIED_CLOSED
  discoveredDate   String
  resolvedDate     String?
  photoUrl         String?
  createdAt        DateTime  @default(now())

  project          Project   @relation(fields: [projectId], references: [id])
}

model MaterialRequirement {
  id                 String   @id @default(uuid())
  projectId          String
  projectName        String
  contractorId       String
  contractorName     String
  category           String
  itemName           String
  specification      String
  requiredQty        Int
  orderedQty         Int      @default(0)
  deliveredQty       Int      @default(0)
  remainingQty       Int
  unit               String
  estimatedUnitPrice Float
  selectedDealerId   String?
  selectedDealerName String?
  status             String   @default("PENDING")
  createdAt          DateTime @default(now())

  project            Project  @relation(fields: [projectId], references: [id])
}

model Product {
  id               String        @id @default(uuid())
  dealerId         String
  dealerName       String
  name             String
  category         String
  brand            String
  specifications   String
  unit             String
  unitPrice        Float
  stockQty         Int
  availableQty     Int           @default(0)
  reservedQty      Int           @default(0)
  moq              Int           @default(1)
  deliveryEtaDays  Int           @default(1)
  isVerifiedDealer Boolean       @default(true)
  rating           Float         @default(4.9)
  stockStatus      String        @default("IN_STOCK")

  dealer           DealerProfile @relation(fields: [dealerId], references: [id])
}

model OrderRequest {
  id                    String        @id @default(uuid())
  projectId             String
  projectName           String
  homeownerId           String
  homeownerName         String
  contractorId          String?
  contractorName        String?
  dealerId              String
  dealerName            String
  materialRequirementId String?
  createdByRole         String
  itemsJson             String
  totalAmount           Float
  status                String        @default("REQUESTED")
  expectedDeliveryDate  String?
  notes                 String?
  createdAt             DateTime      @default(now())

  project               Project       @relation(fields: [projectId], references: [id])
  dealer                DealerProfile @relation(fields: [dealerId], references: [id])
  deliveryJobs          DeliveryJob[]
}

model DeliveryJob {
  id              String       @id @default(uuid())
  orderId         String
  projectId       String
  projectName     String
  dealerId        String
  dealerName      String
  vehicleNumber   String?
  pickupAddress   String
  deliveryAddress String
  status          String       @default("IN_TRANSIT")
  estimatedEta    String
  dispatchedQty   Int?
  deliveredQty    Int?
  createdAt       DateTime     @default(now())

  order           OrderRequest @relation(fields: [orderId], references: [id])
  project         Project      @relation(fields: [projectId], references: [id])
}

model ProjectLedgerEvent {
  id          String   @id @default(uuid())
  projectId   String
  actorId     String
  actorName   String
  actorRole   String
  eventType   String
  title       String
  description String
  entityId    String?
  metadata    String?
  timestamp   DateTime @default(now())

  project     Project  @relation(fields: [projectId], references: [id])
}

model Milestone {
  id                   String       @id @default(uuid())
  projectId            String
  title                String
  description          String
  plannedStartDate     String
  plannedEndDate       String
  actualEndDate        String?
  completionPercentage Int          @default(0)
  status               String       @default("PLANNED")
  allocatedBudget      Float
  requiresOwnerApproval Boolean?    @default(true)
  dependsOnMilestoneId String?
  downstreamImpactWarning String?
  project              Project      @relation(fields: [projectId], references: [id])
  siteUpdates          SiteUpdate[]
}

model SiteUpdate {
  id                   String    @id @default(uuid())
  milestoneId          String
  projectId            String
  builderId            String
  builderName          String
  notes                String
  completionPercentage Int
  photoUrl             String
  timestamp            DateTime  @default(now())

  milestone            Milestone @relation(fields: [milestoneId], references: [id])
  project              Project   @relation(fields: [projectId], references: [id])
}

model DocumentRecord {
  id             String   @id @default(uuid())
  projectId      String
  title          String
  category       String
  fileUrl        String
  uploadedBy     String
  uploadedByRole String
  sizeBytes      Int
  uploadedAt     DateTime @default(now())

  project        Project  @relation(fields: [projectId], references: [id])
}

model ContextualMessage {
  id          String   @id @default(uuid())
  projectId   String
  entityType  String   // PROJECT, MILESTONE, ISSUE, CHANGE_REQUEST, PAYMENT
  entityId    String
  senderId    String
  senderName  String
  senderRole  String
  content     String
  timestamp   DateTime @default(now())
}

model AuditEvent {
  id        String   @id @default(uuid())
  actorId   String
  actorName String
  actorRole String
  action    String
  entity    String
  entityId  String
  metadata  String?
  timestamp DateTime @default(now())

  actor     User     @relation(fields: [actorId], references: [id])
}
