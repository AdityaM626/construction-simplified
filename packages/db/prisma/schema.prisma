datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  fullName     String
  phone        String
  role         String
  isVerified   Boolean  @default(false)
  createdAt    DateTime @default(now())

  builderProfile BuilderProfile?
  dealerProfile  DealerProfile?
  projects       Project[]       @relation("HomeownerProjects")
  assigned       Project[]       @relation("BuilderProjects")
  auditEvents    AuditEvent[]
}

model BuilderProfile {
  id                    String   @id @default(uuid())
  userId                String   @unique
  companyName           String
  experienceYears       Int
  serviceArea           String
  verificationStatus    String   @default("PENDING")
  portfolioJson         String
  rating                Float    @default(4.8)
  completedProjectsCount Int     @default(12)
  specialtiesJson       String
  user                  User     @relation(fields: [userId], references: [id])
}

model DealerProfile {
  id                 String    @id @default(uuid())
  userId             String    @unique
  businessName       String
  gstNumber          String
  serviceRadiusKm    Int
  verificationStatus String    @default("PENDING")
  address            String
  rating             Float     @default(4.7)
  user               User      @relation(fields: [userId], references: [id])
  products           Product[]
  orders             OrderRequest[]
}

model Project {
  id                   String    @id @default(uuid())
  homeownerId          String
  builderId            String?
  name                 String
  type                 String
  location             String
  plotAreaSqFt         Float
  totalBudget          Float
  spentCost            Float     @default(0.0)
  committedCost        Float     @default(0.0)
  targetCompletionDate String
  status               String    @default("PLANNING")
  createdAt            DateTime  @default(now())

  homeowner            User      @relation("HomeownerProjects", fields: [homeownerId], references: [id])
  builder              User?     @relation("BuilderProjects", fields: [builderId], references: [id])
  milestones           Milestone[]
  siteUpdates          SiteUpdate[]
  orderRequests        OrderRequest[]
  documents            DocumentRecord[]
}

model Milestone {
  id                   String   @id @default(uuid())
  projectId            String
  title                String
  description          String
  plannedStartDate     String
  plannedEndDate       String
  actualEndDate        String?
  completionPercentage Int      @default(0)
  status               String   @default("PLANNED")
  allocatedBudget      Float
  project              Project  @relation(fields: [projectId], references: [id])
  siteUpdates          SiteUpdate[]
}

model SiteUpdate {
  id                   String   @id @default(uuid())
  milestoneId          String
  projectId            String
  builderId            String
  builderName          String
  notes                String
  completionPercentage Int
  photoUrl             String
  timestamp            DateTime @default(now())

  milestone            Milestone @relation(fields: [milestoneId], references: [id])
  project              Project   @relation(fields: [projectId], references: [id])
}

model Product {
  id               String   @id @default(uuid())
  dealerId         String
  name             String
  category         String
  brand            String
  specifications   String
  unit             String
  unitPrice        Float
  stockQty         Int
  moq              Int
  deliveryEtaDays  Int
  isVerifiedDealer Boolean  @default(true)
  rating           Float    @default(4.9)

  dealer           DealerProfile @relation(fields: [dealerId], references: [id])
}

model OrderRequest {
  id            String   @id @default(uuid())
  projectId     String
  homeownerId   String
  dealerId      String
  totalAmount   Float
  status        String   @default("REQUESTED")
  createdAt     DateTime @default(now())
  notes         String?

  project       Project       @relation(fields: [projectId], references: [id])
  dealer        DealerProfile @relation(fields: [dealerId], references: [id])
}

model DocumentRecord {
  id             String   @id @default(uuid())
  projectId      String
  title          String
  category       String
  fileUrl        String
  uploadedBy     String
  uploadedByRole String
  sizeBytes      Int
  uploadedAt     DateTime @default(now())

  project        Project  @relation(fields: [projectId], references: [id])
}

model AuditEvent {
  id        String   @id @default(uuid())
  actorId   String
  actorName String
  actorRole String
  action    String
  entity    String
  entityId  String
  metadata  String?
  timestamp DateTime @default(now())

  actor     User     @relation(fields: [actorId], references: [id])
}
