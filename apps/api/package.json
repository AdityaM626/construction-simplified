{
  "name": "@construction-os/api",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/server.js",
  "private": true,
  "scripts": {
    "dev": "npm run build --workspace=@construction-os/data && npm run build && node dist/server.js",
    "build": "tsc -p tsconfig.json",
