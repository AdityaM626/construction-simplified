{
  "name": "construction-os",
  "version": "1.0.0",
  "private": true,
  "description": "Construction OS — Master Platform for Homeowners, Builders, Dealers and Operations",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "db:seed": "npm run seed --workspace=packages/db",
    "test": "node scripts/test-system.js"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  }
}
